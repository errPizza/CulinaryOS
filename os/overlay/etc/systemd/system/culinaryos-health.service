[Unit]
Description=CulinaryOs - comprobación del estado real
After=local-fs.target nftables.service
OnFailure=culinaryos-maintenance.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/culinaryos/health.py
User=root
Group=root
UMask=0022
RuntimeDirectory=culinaryos
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# smartctl lee los discos directamente.
PrivateDevices=no
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/run/culinaryos
MemoryMax=192M
TasksMax=24
CPUQuota=25%
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
