[Unit]
Description=CulinaryOs - snapshot de la base de la sucursal (pg_dump; los datos siguen sellados con el anillo)
After=postgresql.service
Requires=postgresql.service
ConditionPathExists=/etc/culinaryos/branch.json

[Service]
Type=oneshot
User=culinaryos-app
Group=culinaryos-app
UMask=0077
ExecStart=/bin/sh -c 'f=/var/lib/culinaryos-app/snapshots/$(date -u +%%Y%%m%%dT%%H%%M%%SZ).dump; mkdir -p /var/lib/culinaryos-app/snapshots && /usr/bin/pg_dump --format=custom --file="$f" culinaryos && sha256sum "$f" > "$f.sha256" && sync'
StateDirectory=culinaryos-app
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LimitCORE=0
MemoryMax=256M
TasksMax=16
TimeoutStartSec=5min
