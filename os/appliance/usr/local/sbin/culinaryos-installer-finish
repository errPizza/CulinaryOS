#!/bin/sh
# Runs only in the new installation target, from Debian Installer late_command.
set -eu
/usr/bin/python3 - <<'PYCODE'
from pathlib import Path
import grp,pwd,re
names=[name for name in grp.getgrnam('sudo').gr_mem if re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}',name) and name!='operador' and pwd.getpwnam(name).pw_uid>=1000]
if len(names)!=1:raise SystemExit('Se requiere exactamente una cuenta administradora propia en el instalador')
state=Path('/var/lib/culinaryos');state.mkdir(mode=0o700,exist_ok=True);state.chmod(0o700)
marker=state/'setup-admin'
if marker.exists():raise SystemExit('El destino ya contiene un alta; no se sobrescribe')
marker.write_text(names[0]+'\n',encoding='ascii');marker.chmod(0o600)
Path('/etc/machine-id').write_bytes(b'')
Path('/var/lib/culinaryos/installer-complete').write_text('1\n',encoding='ascii')
PYCODE
